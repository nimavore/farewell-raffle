# --- Supabase (from your project's API settings) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SERVER ONLY, never prefix with NEXT_PUBLIC.
# Used by the Next.js API routes for privileged admin actions (lock, reset, config, delete).
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Shared password that gates the /monitor admin page.
ADMIN_PASSWORD=change-me
